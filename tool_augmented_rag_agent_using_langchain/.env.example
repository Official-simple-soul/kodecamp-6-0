# Required — no defaults, the script exits if either is missing.
OPENROUTER_API_KEY=your_openrouter_api_key_here
HF_API_KEY=your_huggingface_api_key_here

# Optional — every variable below already has a sensible default in main.js
# and only needs to be set here to override it.
MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b:free
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=tool_augmented_rag_documents
CHROMA_MEMORY_COLLECTION_NAME=tool_augmented_rag_conversations
DATA_DIR=data
CHUNK_LENGTH=1000
TOP_K=4
MEMORY_TOP_K=3
MEMORY_SIMILARITY_THRESHOLD=0.5
HYBRID_ALPHA=0.6
MAX_OUTPUT_TOKENS=2000
MAX_AGENT_STEPS=12
